    id: check_bounty
    run: |
      # Search for 'bounty' in commit messages between PR base and head
      if git log ${{ github.event.pull_request.base.sha }}..${{ github.event.pull_request.head.sha }} | grep -iq "bounty"; then
        echo "found=true" >> $GITHUB_OUTPUT
      else
        echo "found=false" >> $GITHUB_OUTPUT
      fi

  - name: Edit PR Description with Immunefi Link
    if: steps.check_bounty.outputs.found == 'true'
    run: |
      gh pr edit ${{ github.event.pull_request.number }} --body "$(gh pr view ${{ github.event.pull_request.number }} --json body --template '{{.body}}')

